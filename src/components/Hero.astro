---
const compilado = "20 sep 2026";
---

<section class="hero">
  <div class="hero-top">
    <span class="com">/* portafolio — última compilación: {compilado} */</span>
  </div>

  <div class="split">
    <!-- mitad izquierda: identidad -->
    <div class="side-a">
      <h1>Guillermo<span class="cursor" aria-hidden="true"></span></h1>

      <div class="decl">
        <div>
          <span class="kw">const</span> rol <span class="pun">=</span>
          <span class="str">"Fullstack jr"</span><span class="pun">;</span>
        </div>
        <div>
          <span class="kw">const</span> stack <span class="pun">=</span>
          <span class="str">".NET · React · MongoDB · TypeScript"</span><span
            class="pun">;</span
          >
        </div>
        <div>
          <span class="kw">const</span> base <span class="pun">=</span>
          <span class="str">"Puebla, MX"</span><span class="pun">;</span>
        </div>
      </div>
    </div>

    <!-- mitad derecha: qué hace y si está disponible -->
    <div class="side-b">
      <!-- Frase 1 -->
      <p class="lede">
        Diseño interfaces en <em>React&nbsp; + Zod</em> y servicios en <em
          >.NET</em
        >.
      </p>

      <!-- Frase 2 con espacio arriba -->
      <p class="lede" style="margin-top: 16px;">
        Actualmente construyo API´s REST multi-tenant en sistemas ERP´s
      </p>

      <div class="avail">
        <span class="dot"></span>Disponible para roles junior fullstack y
        freelance
      </div>
    </div>
  </div>

  <div class="scroll-cue" aria-hidden="true"><i></i>scroll</div>
</section>

<style>
  .hero {
    min-height: calc(90svh - var(--bar-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 40px 24px;
  }

  .hero-top {
    font-size: 12.5px;
    margin-bottom: clamp(28px, 5vh, 56px);
  }

  /* las dos mitades, alineadas POR ABAJO:
     el nombre grande cuelga desde arriba y la columna derecha
     sube hasta encontrarlo. Alinear por arriba deja un hueco muerto. */
  .split {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(28px, 5vw, 68px);
    align-items: end;
  }

  .side-b {
    padding-left: clamp(28px, 5vw, 68px);
    border-left: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3.2vh, 32px);
  }

  h1 {
    font-size: clamp(42px, 8.2vw, 80px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
    margin: 0 0 clamp(22px, 3.4vh, 34px);
    text-wrap: balance;
  }

  .decl {
    font-size: clamp(14px, 1.55vw, 18px);
    line-height: 1.95;
  }
  /* si la pantalla es muy angosta la línea se desliza en vez de romperse */
  .decl div {
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .decl div::-webkit-scrollbar {
    display: none;
  }

  .lede {
    font-family: var(--sans);
    font-size: clamp(20px, 2.55vw, 31px);
    line-height: 1.38;
    letter-spacing: -0.018em;
    color: var(--fg-2);
    margin: 0;
    text-wrap: pretty;
  }
  .lede em {
    color: var(--fg);
    font-style: normal;
    font-weight: 500;
  }

  .avail {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: clamp(13px, 1.35vw, 16px);
    color: var(--fg-2);
  }
  .avail .dot {
    width: 8px;
    height: 8px;
    position: relative;
  }
  .avail .dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.4s var(--ease) infinite;
  }
  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70% {
      transform: scale(2.6);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  .cursor {
    display: inline-block;
    width: 0.4em;
    height: 0.82em;
    background: var(--accent);
    vertical-align: -0.02em;
    margin-left: 0.08em;
    animation: blink 1.15s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .scroll-cue {
    margin-top: clamp(40px, 7vh, 72px);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11.5px;
    color: var(--fg-3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .scroll-cue i {
    display: block;
    width: 1px;
    height: 26px;
    background: linear-gradient(to bottom, var(--fg-3), transparent);
    animation: drop 1.9s var(--ease) infinite;
  }
  @keyframes drop {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    45% {
      transform: scaleY(1);
      transform-origin: top;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor,
    .scroll-cue i,
    .avail .dot::after {
      animation: none;
    }
  }

  /* abajo de 820px las mitades se apilan y la línea se vuelve horizontal */
  @media (max-width: 820px) {
    .split {
      grid-template-columns: 1fr;
      gap: clamp(26px, 4vh, 40px);
      align-items: start;
    }
    .side-b {
      padding-left: 0;
      padding-top: clamp(26px, 4vh, 40px);
      border-left: none;
      border-top: 1px solid var(--rule);
    }
    h1 {
      font-size: clamp(44px, 12vw, 72px);
    }
    .lede {
      font-size: clamp(20px, 4.4vw, 28px);
    }
    .decl {
      font-size: clamp(14px, 3vw, 17px);
    }
  }
</style>

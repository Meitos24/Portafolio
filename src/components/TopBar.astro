---
/** Las 5 tintas. Cada una trae su par claro/oscuro ya calibrado para contraste. */
// const tintas = [
//   { nombre: 'cobalto',   claro: '#2f43d2', oscuro: '#9aa8ff' },
//   { nombre: 'verdigris', claro: '#0e6f66', oscuro: '#5fd6c5' },
//   { nombre: 'magenta',   claro: '#b3165c', oscuro: '#ff8fb8' },
//   { nombre: 'ámbar',     claro: '#8f5a06', oscuro: '#eeb65e' },
//   { nombre: 'violeta',   claro: '#6429c4', oscuro: '#c3a6ff' },
// ];
---

<header class="bar" id="bar">
  <div class="file">~/portafolio/<b>index.astro</b></div>

  <div class="bar-r">
    <!-- <div class="inks">
      <span>tinta</span>
      {
        tintas.map((t, i) => (
          <button
            class="ink"
            type="button"
            data-l={t.claro}
            data-d={t.oscuro}
            style={`--sw:${t.claro};--sw-d:${t.oscuro}`}
            aria-pressed={i === 0 ? 'true' : 'false'}
            title={t.nombre}
            aria-label={`Tinta ${t.nombre}`}
          />
        ))
      }
    </div> -->

    <button class="tog" id="theme-toggle" type="button">tema</button>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 10px 20px;
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(10px);
    transition: border-color .3s var(--ease);
  }
  /* el borde solo aparece cuando ya despegaste del scroll */
  .bar.stuck { border-bottom-color: var(--rule); }

  .file {
    font-size: 12.5px;
    color: var(--fg-3);
    letter-spacing: .02em;
    white-space: nowrap;
  }
  .file b { color: var(--fg-2); font-weight: 500; }

  .bar-r { margin-left: auto; display: flex; align-items: center; gap: 14px; }

  .inks { display: flex; align-items: center; gap: 7px; }
  .inks span {
    font-size: 11px;
    color: var(--fg-3);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .ink {
    width: 15px;
    height: 15px;
    padding: 0;
    border-radius: 50%;
    cursor: pointer;
    border: 1px solid color-mix(in srgb, var(--fg) 22%, transparent);
    background: var(--sw);
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .ink:hover { transform: scale(1.18); }
  .ink[aria-pressed="true"] {
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 3.5px var(--sw);
    transform: scale(1.1);
  }

  /* en oscuro la muestra usa la variante clara del par */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .ink { background: var(--sw-d); }
    :global(:root:not([data-theme="light"])) .ink[aria-pressed="true"] {
      box-shadow: 0 0 0 2px var(--bg), 0 0 0 3.5px var(--sw-d);
    }
  }
  :global(:root[data-theme="dark"]) .ink { background: var(--sw-d); }
  :global(:root[data-theme="dark"]) .ink[aria-pressed="true"] {
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 3.5px var(--sw-d);
  }

  .tog {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg-2);
    cursor: pointer;
    background: none;
    border: 1px solid var(--rule-2);
    border-radius: 3px;
    padding: 3px 9px;
  }
  .tog:hover { color: var(--fg); border-color: var(--fg-3); }

  @media (prefers-reduced-motion: reduce) {
    .ink { transition: none; }
  }
  @media (max-width: 560px) {
    .bar { gap: 10px; }
  }
</style>
